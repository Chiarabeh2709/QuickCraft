# Copy this file to .env and fill in your own values. Never commit .env.

# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The admin account, created at startup if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: defaults to instance/quickcraft.db
# DATABASE_URL=sqlite:///quickcraft.db
